# Optional: enables the existing PostgreSQL health check only.
DATABASE_URL=

# Optional public metadata origin. Set the real HTTPS origin before production.
NEXT_PUBLIC_SITE_URL=

# Optional: enables the hosted catalog and administrator authentication.
# Use the project's public/publishable key, NEVER a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# No administrator password or service-role key is required by this application.
# Create the owner-controlled admin in Supabase Auth and add its user UUID to
# public.administrators using the reviewed setup procedure in DEVELOPMENT_GUIDE.md.
